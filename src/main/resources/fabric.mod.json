    {
      "config": "txocclusionculling.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "sodium": "*",
    "java": ">=25"
  }
}
